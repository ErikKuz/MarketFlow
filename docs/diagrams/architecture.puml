@startuml
title MarketFlow - Current Modular Monolith

skinparam componentStyle rectangle
skinparam shadowing false

actor Buyer
actor Seller

rectangle "MarketFlow Spring Boot Application" {
  component "Spring Security
Session + CSRF" as Security
  component "MVC Controllers" as Mvc
  component "REST Controllers" as Rest
  component "Transactional Services" as Services
  component "Spring Data JPA" as Repositories
  component "Transactional Outbox" as Outbox
  component "Outbox Publisher" as Publisher
  component "History Consumer" as History
  component "Buyer Notification Consumer" as BuyerNotifications
  component "Seller Notification Consumer" as SellerNotifications
  component "Thymeleaf" as Views
  component "Flyway" as Flyway
}

database "PostgreSQL" as PostgreSQL
queue "RabbitMQ\nTopic Exchange + DLQ" as RabbitMQ

Buyer --> Security
Seller --> Security
Security --> Mvc
Security --> Rest
Mvc --> Services
Rest --> Services
Services --> Repositories
Repositories --> PostgreSQL
Services --> Outbox
Outbox --> PostgreSQL
Publisher --> PostgreSQL : read NEW / mark PUBLISHED
Publisher --> RabbitMQ : JSON + publisher confirm
RabbitMQ --> History
RabbitMQ --> BuyerNotifications
RabbitMQ --> SellerNotifications
History --> PostgreSQL
BuyerNotifications --> PostgreSQL
SellerNotifications --> PostgreSQL
Mvc --> Views
Flyway --> PostgreSQL : V1-V17
@enduml
